# Copy this file to .env and fill in your values. Never commit .env!

# ─── Zerodha: Console API (recommended for development) ──────────────
# Auto-login via jugaad-trader — no daily re-auth needed.
# Get your TOTP secret when setting up 2FA on Zerodha.
ZERODHA_USER_ID=
ZERODHA_PASSWORD=
ZERODHA_TOTP_SECRET=

# ─── Zerodha: Kite Connect OAuth (alternative, production-grade) ─────
# Register at https://developers.kite.trade/
# Set redirect URL to http://127.0.0.1:8000/api/auth/callback
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=          # auto-populated by OAuth callback

# ─── AI Analysis ─────────────────────────────────────────────────────
# Groq (primary — free tier): https://console.groq.com
GROQ_API_KEY=

# Google Gemini (fallback): https://aistudio.google.com/
GOOGLE_API_KEY=

# Anthropic (optional): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─── App settings ────────────────────────────────────────────────────
USE_DUMMY_DATA=true
