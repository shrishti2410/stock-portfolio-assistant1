# Copy this file to .env and fill in your values. Never commit .env!

# Zerodha Kite Connect credentials
ZERODHA_API_KEY=your_api_key_here
ZERODHA_ACCESS_TOKEN=your_access_token_here

# Anthropic API key for TradingAgents / AI analysis
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# App settings
# Set to "true" to use dummy portfolio data when Zerodha token is missing
USE_DUMMY_DATA=true
