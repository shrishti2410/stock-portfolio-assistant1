# ════════════════════════════════════════════════════════════════
# Trading Desk — cloud .env template
# Copy to .env on the server:   cp .env.deploy.example .env
# ════════════════════════════════════════════════════════════════

# ── REQUIRED ────────────────────────────────────────────────────
# Public hostname Caddy serves with auto-HTTPS (DuckDNS is free).
# Leave as ":80" to test over plain HTTP on the raw IP first.
APP_DOMAIN=mytradingdesk.duckdns.org

# Secret used to encrypt stored broker credentials + sign sessions.
# Generate with:  openssl rand -hex 32     — NEVER reuse elsewhere.
APP_SECRET_KEY=change-me-openssl-rand-hex-32

# First admin login (created on first boot only; change the password
# after first login from Settings → Users).
APP_ADMIN_USER=rahul
APP_ADMIN_PASSWORD=pick-a-strong-password

# ── OPTIONAL: LLM (strategy chat) ───────────────────────────────
# Budget caps ($1/day, $10/month defaults) are enforced in-app.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# ── OPTIONAL: notifications ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# ── OPTIONAL: market data keys (activate the adapters) ──────────
ALPACA_API_KEY=
ALPACA_API_SECRET=
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# ── DELIBERATELY ABSENT: Zerodha credentials ────────────────────
# Do NOT put ZERODHA_* here. Each user connects their own Zerodha
# account from the UI (Settings → Broker Connection); credentials are
# encrypted per-user in the database with APP_SECRET_KEY.
